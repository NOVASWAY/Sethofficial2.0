# Database Configuration
DATABASE_URL=postgresql://clinic_user:clinic_password@postgres:5432/clinic_management
POSTGRES_USER=clinic_user
POSTGRES_PASSWORD=clinic_password
POSTGRES_DB=clinic_management

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Server Configuration
RUST_LOG=info
HOST=0.0.0.0
PORT=8080
ENVIRONMENT=production

# SSL Configuration
SSL_ENABLED=false
SSL_CERT_PATH=certs/cert.pem
SSL_KEY_PATH=certs/key.pem

# CORS Configuration
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Data Encryption
ENCRYPTION_KEY=your-32-byte-encryption-key-change-in-production-123456789012

# Redis Configuration
REDIS_URL=redis://redis:6379
REDIS_ENABLED=true
REDIS_PASSWORD=

# M-Pesa Configuration (Production)
MPESA_ENVIRONMENT=production
MPESA_CONSUMER_KEY=your_production_consumer_key
MPESA_CONSUMER_SECRET=your_production_consumer_secret
MPESA_BUSINESS_SHORT_CODE=your_business_short_code
MPESA_PASSKEY=your_production_passkey
MPESA_CALLBACK_URL=https://yourdomain.com/api/mpesa/callback

# SMS Configuration
SMS_API_KEY=your_africastalking_api_key
SMS_USERNAME=your_africastalking_username
SMS_SENDER_ID=SETHMED
SMS_BASE_URL=https://api.africastalking.com/version1

# Email Configuration
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=your_sendgrid_api_key
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=Seth Medical Clinic

# Security
RATE_LIMIT_REQUESTS_PER_MINUTE=100
