# ============================================
# Backend Environment Configuration
# ============================================
# Copy this file to backend/.env and update values
# SECURITY: Never commit .env files!
# ============================================

# ============================================
# DATABASE CONFIGURATION
# ============================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://clinic_user:clinic_password@localhost:5432/clinic_management

# Database connection pool
DB_POOL_SIZE=20
DB_POOL_MAX_CONNECTIONS=50

# ============================================
# REDIS CONFIGURATION (Optional)
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true

# ============================================
# JWT CONFIGURATION
# ============================================
# CRITICAL: Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=7

# ============================================
# SERVER CONFIGURATION
# ============================================
HOST=0.0.0.0
PORT=8080
RUST_LOG=debug
RUST_BACKTRACE=1
ENVIRONMENT=development

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:3000

# ============================================
# SECURITY SETTINGS
# ============================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
MAX_LOGIN_ATTEMPTS=5
SESSION_TIMEOUT=1800

# ============================================
# EMAIL CONFIGURATION
# ============================================
# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Email sender
FROM_EMAIL=noreply@sethmedicalclinic.com
FROM_NAME=Seth Medical Clinic

# Alternative: SendGrid
SENDGRID_API_KEY=your-sendgrid-api-key

# ============================================
# SMS CONFIGURATION (Optional)
# ============================================
# Africa's Talking
AFRICASTALKING_API_KEY=your-africas-talking-api-key
AFRICASTALKING_USERNAME=your-africas-talking-username
AFRICASTALKING_SENDER_ID=SETHMED

# ============================================
# FILE UPLOAD
# ============================================
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# ============================================
# CORS
# ============================================
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================
# MFA CONFIGURATION
# ============================================
MFA_ISSUER_NAME=Seth Medical Clinic

# ============================================
# MONITORING (Optional)
# ============================================
ENABLE_METRICS=true
METRICS_PORT=9090
