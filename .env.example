# ==================================================
# Seth Medical Clinic - Environment Variables
# ==================================================
# Copy this file to .env.local and fill in your values.

# ---- Database (Supabase) ----
# 1. Create a free project at https://supabase.com
# 2. Go to Settings → Database → Connection string → URI
# 3. Replace [YOUR-PASSWORD] and [PROJECT-REF] with your values
# 4. Keep ?pgbouncer=true (required for Supabase connection pooler)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true&connect_timeout=5"

# ---- NextAuth.js ----
# Production: set NEXTAUTH_URL to your Vercel deployment URL
# Generate a secret: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"

# ---- JWT (legacy, can be removed after full migration) ----
JWT_SECRET="your-jwt-secret-here"

# ---- App ----
# Production: set to your Vercel deployment URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- M-Pesa (Safaricom) ----
MPESA_ENV="sandbox"
MPESA_CONSUMER_KEY="your-consumer-key"
MPESA_CONSUMER_SECRET="your-consumer-secret"
MPESA_SHORTCODE="174379"
MPESA_PASSKEY="your-passkey"
MPESA_CALLBACK_URL="https://your-domain.com/api/mpesa/callback"

# ---- Vercel Deployment ----
# No special env vars needed — Vercel auto-detects Next.js.
# Just set the above variables in Vercel Dashboard → Settings → Environment Variables.
