# Database (Supabase - update with your credentials)
# Get from: Supabase Dashboard → Settings → Database → Connection string → URI
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true&connect_timeout=5"

# NextAuth.js
# Production: set to your Vercel deployment URL
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="seth-medical-clinic-dev-secret-change-in-production"

# App
# Production: set to your Vercel deployment URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

