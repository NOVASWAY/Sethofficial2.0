{
  "name": "seth-medical-clinic",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "dev": "next dev",
    "mock:start": "node tools/mock-backend/server.js",
    "demo:start": "sh tools/start-demo.sh",
    "demo:run": "node tools/demo-puppeteer.js",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:dashboard": "jest --testPathPattern=dashboard.test.tsx",
    "test:integration": "jest --testPathPattern=integration.test.tsx",
    "test:performance": "jest --testPathPattern=performance.test.tsx",
    "test:accessibility": "jest --testPathPattern=accessibility.test.tsx",
    "test:all": "node scripts/test-runner.js",
    "test:frontend": "node scripts/test-runner.js --frontend",
    "test:backend": "node scripts/test-runner.js --backend",
    "type-check": "tsc --noEmit",
    "backend:dev": "cd backend && cargo run",
    "backend:build": "cd backend && cargo build",
    "backend:test": "cd backend && cargo test",
    "backend:check": "cd backend && cargo check",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "db:migrate": "cd backend && sqlx migrate run",
    "db:reset": "cd backend && sqlx database drop && sqlx database create && sqlx migrate run",
    "db:seed": "cd backend && cargo run -- --seed",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:fix": "next lint --fix",
    "prepare": "husky install"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.0.5",
