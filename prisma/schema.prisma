  @@index([createdAt])
  @@index([fileName])
  @@map("import_sessions")
}

model ImportAuditLog {
  id               String   @id @default(uuid()) @db.Uuid
  importSessionId  String   @map("import_session_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  action           String   @db.VarChar(100)
  recordIndex      Int?     @map("record_index")
  recordData       Json?    @map("record_data")
  result           String   @db.VarChar(20)
  errorMessage     String?  @map("error_message") @db.Text
  errorDetails     Json?    @map("error_details")
  batchNumber      Int?     @map("batch_number")
  timestamp        DateTime @default(now()) @db.Timestamptz()

  importSession    ImportSession @relation(fields: [importSessionId], references: [id], onDelete: Cascade)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  patientId        String?  @map("patient_id") @db.Uuid
  patient          Patient? @relation(fields: [patientId], references: [id])

  @@index([importSessionId])
  @@index([userId])
  @@index([action])
  @@index([timestamp])
  @@index([result])
  @@map("import_audit_logs")
}

model ImportStatistic {
  id               String   @id @default(uuid()) @db.Uuid
  importSessionId  String   @map("import_session_id") @db.Uuid
  metricName       String   @map("metric_name") @db.VarChar(100)
  metricValue      Decimal  @map("metric_value") @db.Decimal(10, 2)
  metricUnit       String?  @map("metric_unit") @db.VarChar(50)
  recordedAt       DateTime @default(now()) @map("recorded_at") @db.Timestamptz()

  importSession    ImportSession @relation(fields: [importSessionId], references: [id], onDelete: Cascade)

  @@index([importSessionId])
  @@index([metricName])
  @@index([recordedAt])
  @@map("import_statistics")
}

// ==========================================
// MONITORING & BACKUP
// ==========================================

model ApplicationLog {
  id              String   @id @default(uuid()) @db.Uuid
  timestamp       DateTime @db.Timestamptz()
  level           String   @db.VarChar(10)
  message         String   @db.Text
  module          String   @db.VarChar(255)
  function        String?  @db.VarChar(255)
  userId          String?  @map("user_id") @db.Uuid
  sessionId       String?  @map("session_id") @db.VarChar(255)
  requestId       String?  @map("request_id") @db.VarChar(255)
  traceId         String?  @map("trace_id") @db.VarChar(255)
  spanId          String?  @map("span_id") @db.VarChar(255)
  context         Json     @default("{}")
  errorDetails    Json?    @map("error_details")
  performanceMetrics Json? @map("performance_metrics")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([timestamp])
  @@index([level])
  @@index([userId])
  @@index([sessionId])
  @@index([requestId])
  @@index([traceId])
  @@index([module])
  @@map("application_logs")
}

model HealthCheck {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @db.VarChar(255)
  status         String   @db.VarChar(20)
  message        String   @db.Text
  details        Json?
  responseTimeMs Decimal  @default(0) @map("response_time_ms") @db.Decimal(10, 3)
  lastChecked    DateTime @default(now()) @map("last_checked") @db.Timestamptz()
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([name])
  @@index([status])
  @@index([lastChecked])
  @@map("health_checks")
}

model AlertConfig {
  id                   String   @id @db.VarChar(255)
  name                 String   @db.VarChar(255)
  alertType            String   @map("alert_type") @db.VarChar(50)
  severity             String   @db.VarChar(20)
  enabled              Boolean  @default(true)
  threshold            Decimal? @db.Decimal(10, 3)
  condition            String   @db.Text
  notificationChannels String[] @map("notification_channels")
  cooldownMinutes      Int      @default(15) @map("cooldown_minutes")
  lastTriggered        DateTime? @map("last_triggered") @db.Timestamptz()
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  alerts               Alert[]

  @@map("alert_configs")
}

model Alert {
  id               String   @id @default(uuid()) @db.Uuid
  configId         String   @map("config_id") @db.VarChar(255)
  title            String   @db.VarChar(255)
  message          String   @db.Text
  severity         String   @db.VarChar(20)
  alertType        String   @map("alert_type") @db.VarChar(50)
  triggeredAt      DateTime @default(now()) @map("triggered_at") @db.Timestamptz()
  resolvedAt       DateTime? @map("resolved_at") @db.Timestamptz()
  acknowledgedById String?  @map("acknowledged_by") @db.Uuid
  acknowledgedAt   DateTime? @map("acknowledged_at") @db.Timestamptz()
  context          Json     @default("{}")
  notificationsSent String[] @map("notifications_sent")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  config           AlertConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId])
  @@index([severity])
  @@index([alertType])
  @@index([triggeredAt])
  @@index([resolvedAt])
  @@index([acknowledgedById])
  @@map("alerts")
}

model SystemMetric {
  id           String   @id @default(uuid()) @db.Uuid
  metricName   String   @map("metric_name") @db.VarChar(255)
  metricValue  Decimal  @map("metric_value") @db.Decimal(15, 6)
  metricLabels Json     @default("{}") @map("metric_labels")
  timestamp    DateTime @db.Timestamptz()
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([metricName])
  @@index([timestamp])
  @@map("system_metrics")
}

model PerformanceMetric {
  id               String   @id @default(uuid()) @db.Uuid
  operationName    String   @map("operation_name") @db.VarChar(255)
  durationMs       Decimal  @map("duration_ms") @db.Decimal(10, 3)
  memoryUsageMb    Decimal? @map("memory_usage_mb") @db.Decimal(10, 3)
  cpuUsagePercent  Decimal? @map("cpu_usage_percent") @db.Decimal(5, 2)
  databaseQueries  Int?     @default(0) @map("database_queries")
  cacheHits        Int?     @default(0) @map("cache_hits")
  cacheMisses      Int?     @default(0) @map("cache_misses")
  userId           String?  @map("user_id") @db.Uuid
  sessionId        String?  @map("session_id") @db.VarChar(255)
  requestId        String?  @map("request_id") @db.VarChar(255)
  context          Json     @default("{}")
  timestamp        DateTime @db.Timestamptz()
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([operationName])
  @@index([timestamp])
  @@index([userId])
  @@map("performance_metrics")
}

model BackupJob {
  id           String   @id @default(uuid()) @db.Uuid
  backupType   String   @map("backup_type") @db.VarChar(20)
  status       String   @default("pending") @db.VarChar(20)
  startedAt    DateTime @default(now()) @map("started_at") @db.Timestamptz()
  completedAt  DateTime? @map("completed_at") @db.Timestamptz()
  filePath     String?  @map("file_path") @db.Text
  fileSizeBytes BigInt? @map("file_size_bytes")
  errorMessage String?  @map("error_message") @db.Text
  createdById  String?  @map("created_by") @db.Uuid
  description  String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  createdBy    User?    @relation(fields: [createdById], references: [id])
  restoreJobs  RestoreJob[]

  @@index([status])
  @@index([startedAt])
  @@index([backupType])
  @@index([createdById])
  @@map("backup_jobs")
}

model RestoreJob {
  id           String   @id @default(uuid()) @db.Uuid
  backupId     String   @map("backup_id") @db.Uuid
  restoreType  String   @map("restore_type") @db.VarChar(50)
  status       String   @default("pending") @db.VarChar(20)
  startedAt    DateTime @default(now()) @map("started_at") @db.Timestamptz()
  completedAt  DateTime? @map("completed_at") @db.Timestamptz()
  errorMessage String?  @map("error_message") @db.Text
  createdById  String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  backup       BackupJob @relation(fields: [backupId], references: [id])
  createdBy    User?     @relation(fields: [createdById], references: [id])

  @@index([status])
  @@index([backupId])
  @@index([createdById])
  @@map("restore_jobs")
}

// ==========================================
// USER PREFERENCES & SETTINGS
// ==========================================

model UserPreference {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @map("user_id") @db.Uuid
  layout     Json     @default("{}")
  defaultView String? @map("default_view") @db.VarChar(50)
  notifications Json @default("{}")
  autoRefresh Boolean @default(false) @map("auto_refresh")
  refreshInterval Int @default(30) @map("refresh_interval")
  theme      String   @default("light") @db.VarChar(20)
  language   String   @default("en") @db.VarChar(10)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model UserSetting {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @map("user_id") @db.Uuid
  key        String   @db.VarChar(100)
  value      Json
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("user_settings")
}

model PatientContext {
  id         String   @id @default(uuid()) @db.Uuid
  patientId  String   @map("patient_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  context    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  user       User     @relation("PatientContextUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([patientId, userId])
  @@map("patient_contexts")
}

model ActivityLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(100)
  resource   String   @db.VarChar(50)
  resourceId String?  @map("resource_id") @db.Uuid
  details    Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.Text
  timestamp  DateTime @default(now()) @db.Timestamptz()

  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([timestamp])
  @@map("activity_logs")
}

model SystemSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(255)
  value       String   @db.Text
  description String?  @db.Text
  category    String?  @db.VarChar(100)
  isEncrypted Boolean  @default(false) @map("is_encrypted")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([category])
  @@index([key])
  @@map("system_settings")
}
