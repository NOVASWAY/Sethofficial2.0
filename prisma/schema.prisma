generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// CORE MODELS
// ==========================================

model User {
  id            String   @id @default(uuid()) @db.Uuid
  username      String   @unique @db.VarChar(50)
  email         String   @unique @db.VarChar(255)
  passwordHash  String   @map("password_hash") @db.VarChar(255)
  role          String   @db.VarChar(50)
  name          String   @db.VarChar(255)
  department    String   @db.VarChar(100)
  permissions   Json     @default("[]")
  isActive      Boolean  @default(true) @map("is_active")
  avatar        String?  @db.VarChar(500)

  // MFA fields
  mfaEnabled    Boolean  @default(false) @map("mfa_enabled")
  mfaMethod     String?  @db.VarChar(20) @map("mfa_method")
  mfaSecret     String?  @map("mfa_secret")
  phoneNumber   String?  @db.VarChar(20) @map("phone_number")
  emailVerified Boolean  @default(false) @map("email_verified")

  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  patients          Patient[]          @relation("PatientDoctor")
  consultations     Consultation[]     @relation("ConsultationDoctor")
  createdConsultations Consultation[]   @relation("ConsultationCreator")
  appointments      Appointment[]      @relation("AppointmentDoctor")
  prescriptions     Prescription[]     @relation("PrescriptionDoctor")
  dispensedPrescriptions Prescription[] @relation("PrescriptionDispenser")
  createdPrescriptions Prescription[]  @relation("PrescriptionCreator")
  invoices          Invoice[]          @relation("InvoiceCreator")
  labOrders         LabTestOrder[]     @relation("LabOrderClinician")
  labOrderCreated   LabTestOrder[]     @relation("LabOrderCreator")
  labResultVerified LabTestResult[]    @relation("LabResultVerifier")
  labResultReviewed LabTestResult[]    @relation("LabResultReviewer")
  labResultCreated  LabTestResult[]    @relation("LabResultCreator")
  auditLogs         AuditLog[]
  files             File[]             @relation("FileUploader")
  mfaRecoveryCodes  MfaRecoveryCode[]
  mfaSessions       MfaSession[]
  mfaAttempts       MfaVerificationAttempt[]
  importSessions    ImportSession[]
  importAuditLogs   ImportAuditLog[]
  notifications     Notification[]     @relation("NotificationRecipient")
  createdNotifications Notification[]  @relation("NotificationCreator")
  notes             Note[]             @relation("NoteUser")
  notesCreated      Note[]             @relation("NoteCreator")
  notificationLogs  NotificationLog[]
  tasksAssigned     Task[]             @relation("TaskAssignee")
  tasksCreated      Task[]             @relation("TaskCreator")
  taskUpdates       TaskUpdate[]
  taskAssignHistory TaskAssignmentHistory[] @relation("TaskHistoryNewAssignee")
  taskAssignPrev    TaskAssignmentHistory[] @relation("TaskHistoryPrevAssignee")
  taskAssignBy      TaskAssignmentHistory[] @relation("TaskHistoryAssigner")
  announcements     Announcement[]
  updatedAnnouncements Announcement[]  @relation("AnnouncementUpdater")
  announcementAcks  AnnouncementAcknowledgment[]
  announcementComments AnnouncementComment[]
  backupJobs        BackupJob[]
  restoreJobs       RestoreJob[]
  stockMovements    StockMovement[]
  shaClaims         ShaClaim[]
  financialTransactions FinancialTransaction[]
  stockAdjustments  StockAdjustment[]
  reports           Report[]
  activityLogs      ActivityLog[]
  userPreferences   UserPreference?
  userSettings      UserSetting?
  patientContexts   PatientContext[]   @relation("PatientContextUser")

  @@map("users")
}

model Patient {
  id              String   @id @default(uuid()) @db.Uuid
  patientNumber   String   @unique @map("patient_number") @db.VarChar(20)
  firstName       String   @map("first_name") @db.VarChar(50)
  lastName        String   @map("last_name") @db.VarChar(50)
  dateOfBirth     DateTime @map("date_of_birth") @db.Date
  gender          String   @db.VarChar(10)
  phone           String   @db.VarChar(15)
  email           String?  @db.VarChar(255)
  address         String?  @db.Text
  emergencyContact String? @map("emergency_contact") @db.VarChar(100)
  emergencyPhone  String?  @map("emergency_phone") @db.VarChar(15)
  bloodType       String?  @map("blood_type") @db.VarChar(10)
  allergies       Json     @default("[]")
  medicalHistory  String?  @map("medical_history") @db.Text
  insuranceType   String?  @map("insurance_type") @db.VarChar(50)
  insuranceNumber String?  @map("insurance_number") @db.VarChar(50)
  age             Int?
  photoUrl        String?  @map("photo_url") @db.VarChar(500)

  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  doctor          User?    @relation("PatientDoctor", fields: [doctorId], references: [id])
  doctorId        String?  @map("doctor_id") @db.Uuid
  consultations   Consultation[]
  appointments    Appointment[]
  prescriptions   Prescription[]
  invoices        Invoice[]
  labOrders       LabTestOrder[]
  shaClaims       ShaClaim[]
  notes           Note[]
  tasks           Task[]
  importSessions  ImportSession[]
  importAuditLogs ImportAuditLog[]
  patientContexts PatientContext[]

  @@index([patientNumber])
  @@index([firstName, lastName])
  @@index([phone])
  @@map("patients")
}

model Consultation {
  id                String   @id @default(uuid()) @db.Uuid
  consultationNumber String  @unique @map("consultation_number") @db.VarChar(20)
  patientId         String   @map("patient_id") @db.Uuid
  clinicianId       String?  @map("clinician_id") @db.Uuid
  doctorId          String   @map("doctor_id") @db.Uuid
  appointmentId     String?  @map("appointment_id") @db.Uuid
  visitDate         DateTime @map("visit_date") @db.Date
  visitTime         DateTime @map("visit_time") @db.Time(0)
  chiefComplaint    String   @map("chief_complaint") @db.Text
  vitalSigns        Json?    @map("vital_signs")
  physicalExamination String? @map("physical_examination") @db.Text
  diagnosis         String?  @db.Text
  icd11Codes        Json?    @map("icd_11_codes")
  treatmentPlan     String?  @map("treatment_plan") @db.Text
  notes             String?  @db.Text
  followUpDate      DateTime? @map("follow_up_date") @db.Date
  status            String   @default("in_progress") @db.VarChar(20)
  createdBy         String?  @map("created_by") @db.Uuid

  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  patient           Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor            User     @relation("ConsultationDoctor", fields: [doctorId], references: [id], onDelete: Cascade)
  clinician         User?    @relation("ConsultationCreator", fields: [clinicianId], references: [id])
  appointment       Appointment? @relation(fields: [appointmentId], references: [id])
  prescriptions     Prescription[]
  labOrders         LabTestOrder[]
  invoices          Invoice[]
  tasks             Task[]

  @@index([patientId])
  @@index([doctorId])
  @@index([visitDate])
  @@index([status])
  @@map("consultations")
}

model Appointment {
  id          String   @id @default(uuid()) @db.Uuid
  patientId   String   @map("patient_id") @db.Uuid
  doctorId    String   @map("doctor_id") @db.Uuid
  date        DateTime @db.Date
  time        DateTime @db.Time(0)
  duration    Int      @default(30)
  status      String   @default("scheduled") @db.VarChar(20)
  notes       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  patient       Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor        User          @relation("AppointmentDoctor", fields: [doctorId], references: [id], onDelete: Cascade)
  consultation  Consultation[]
  tasks         Task[]

  @@index([patientId])
  @@index([doctorId])
  @@index([date])
  @@map("appointments")
}

// ==========================================
// PHARMACY & INVENTORY
// ==========================================

model Medicine {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @db.VarChar(100)
  genericName   String?  @map("generic_name") @db.VarChar(100)
  category      String?  @db.VarChar(100)
  dosageForm    String?  @map("dosage_form") @db.VarChar(50)
  strength      String?  @db.VarChar(50)
  manufacturer  String?  @db.VarChar(100)
  batchNumber   String?  @unique @map("batch_number") @db.VarChar(50)
  expiryDate    DateTime? @map("expiry_date") @db.Date
  currentStock  Int      @default(0) @map("current_stock")
  minimumStock  Int      @default(0) @map("minimum_stock")
  reorderLevel  Int      @default(10) @map("reorder_level")
  unitPrice     Decimal  @default(0) @map("unit_price") @db.Decimal(10, 2)
  location      String?  @db.VarChar(255)
  description   String?  @db.Text
  sideEffects   String?  @map("side_effects") @db.Text
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  prescriptions     Prescription[]
  prescriptionItems PrescriptionItem[]
  stockMovements    StockMovement[]
  stockAdjustments  StockAdjustment[]
  stockAlerts       StockAlert[]

  @@index([name])
  @@map("medicines")
}

model Prescription {
  id              String   @id @default(uuid()) @db.Uuid
  prescriptionNumber String @unique @map("prescription_number") @db.VarChar(20)
  consultationId  String?  @map("consultation_id") @db.Uuid
  patientId       String   @map("patient_id") @db.Uuid
  clinicianId     String?  @map("clinician_id") @db.Uuid
  doctorId        String   @map("doctor_id") @db.Uuid
  medicationId    String?  @map("medication_id") @db.Uuid
  medicationName  String   @map("medication_name") @db.VarChar(100)
  dosage          String   @db.VarChar(50)
  frequency       String   @db.VarChar(50)
  durationDays    Int      @map("duration_days")
  quantity        Int
  instructions    String?  @db.Text
  medicines       Json     @default("[]")
  dispensed       Boolean  @default(false)
  dispensedById   String?  @map("dispensed_by") @db.Uuid
  dispensedAt     DateTime? @map("dispensed_at") @db.Timestamptz()
  status          String   @default("pending") @db.VarChar(20)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  consultation  Consultation? @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  patient       Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  clinician     User?         @relation("PrescriptionDoctor", fields: [clinicianId], references: [id])
  doctor        User          @relation("PrescriptionCreator", fields: [doctorId], references: [id], onDelete: Cascade)
  medication    Medicine?     @relation(fields: [medicationId], references: [id])
  dispensedBy   User?         @relation("PrescriptionDispenser", fields: [dispensedById], references: [id])
  items         PrescriptionItem[]
  tasks         Task[]

  @@index([patientId])
  @@index([clinicianId])
  @@index([status])
  @@map("prescriptions")
}

model PrescriptionItem {
  id              String   @id @default(uuid()) @db.Uuid
  prescriptionId  String   @map("prescription_id") @db.Uuid
  medicationId    String   @map("medication_id") @db.Uuid
  quantity        Int
  dosage          String   @db.VarChar(255)
  frequency       String   @db.VarChar(100)
  durationDays    Int?     @map("duration_days")
  instructions    String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  prescription    Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medication      Medicine     @relation(fields: [medicationId], references: [id])

  @@index([prescriptionId])
  @@index([medicationId])
  @@map("prescription_items")
}

model StockMovement {
  id               String   @id @default(uuid()) @db.Uuid
  medicationId     String   @map("medication_id") @db.Uuid
  movementType     String   @map("movement_type") @db.VarChar(20)
  quantity         Int
  previousQuantity Int      @map("previous_quantity")
  newQuantity      Int      @map("new_quantity")
  unitCost         Decimal? @map("unit_cost") @db.Decimal(10, 2)
  totalCost        Decimal? @map("total_cost") @db.Decimal(10, 2)
  referenceId      String?  @map("reference_id") @db.Uuid
  referenceType    String?  @map("reference_type") @db.VarChar(50)
  notes            String?  @db.Text
  createdById      String?  @map("created_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()

  medication       Medicine @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  createdBy        User?    @relation(fields: [createdById], references: [id])

  @@index([medicationId])
  @@index([movementType])
  @@index([createdAt])
  @@map("stock_movements")
}

model StockAdjustment {
  id             String   @id @default(uuid()) @db.Uuid
  medicineId     String   @map("medicine_id") @db.Uuid
  quantity       Int
  adjustmentType String   @map("adjustment_type") @db.VarChar(50)
  reason         String?  @db.Text
  performedById  String?  @map("performed_by") @db.Uuid
  referenceId    String?  @map("reference_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  medicine       Medicine @relation(fields: [medicineId], references: [id])
  performedBy    User?    @relation(fields: [performedById], references: [id])

  @@index([medicineId])
  @@index([createdAt])
  @@map("stock_adjustments")
}

model StockAlert {
  id          String   @id @default(uuid()) @db.Uuid
  medicineId  String   @map("medicine_id") @db.Uuid
  alertType   String   @map("alert_type") @db.VarChar(50)
  message     String   @db.Text
  status      String   @default("active") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  medicine    Medicine @relation(fields: [medicineId], references: [id])

  @@map("stock_alerts")
}

// ==========================================
// BILLING & PAYMENTS
// ==========================================

model Service {
  id                String   @id @default(uuid()) @db.Uuid
  serviceCode       String   @unique @map("service_code") @db.VarChar(20)
  serviceName       String   @map("service_name") @db.VarChar(200)
  category          String   @db.VarChar(50)
  description       String?  @db.Text
  unitPrice         Decimal  @map("unit_price") @db.Decimal(10, 2)
  cashPrice         Decimal  @default(0) @map("cash_price") @db.Decimal(10, 2)
  nhifPrice         Decimal? @map("nhif_price") @db.Decimal(10, 2)
  shaPrice          Decimal? @map("sha_price") @db.Decimal(10, 2)
  shaApproved       Boolean  @default(false) @map("sha_approved")
  isActive          Boolean  @default(true) @map("is_active")
  requiresPrescription Boolean @default(false) @map("requires_prescription")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([category])
  @@index([isActive])
  @@index([serviceCode])
  @@map("services")
}

model Invoice {
  id              String   @id @default(uuid()) @db.Uuid
  patientId       String   @map("patient_id") @db.Uuid
  invoiceNumber   String   @unique @map("invoice_number") @db.VarChar(50)
  date            DateTime @db.Date
  consultationId  String?  @map("consultation_id") @db.Uuid
  createdById     String?  @map("created_by") @db.Uuid
  items           Json     @default("[]")
  subtotal        Decimal  @default(0) @db.Decimal(10, 2)
  taxAmount       Decimal  @default(0) @map("tax_amount") @db.Decimal(10, 2)
  totalAmount     Decimal  @default(0) @map("total_amount") @db.Decimal(10, 2)
  paymentStatus   String   @default("pending") @map("payment_status") @db.VarChar(20)
  paymentMethod   String?  @map("payment_method") @db.VarChar(50)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  patient         Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultation    Consultation? @relation(fields: [consultationId], references: [id])
  createdBy       User?    @relation("InvoiceCreator", fields: [createdById], references: [id])
  invoiceItems    InvoiceItem[]
  paymentAllocations PaymentAllocation[]
  shaClaims       ShaClaim[]
  mpesaTransactions MpesaTransaction[]
  tasks           Task[]

  @@index([patientId])
  @@index([invoiceNumber])
  @@map("invoices")
}

model InvoiceItem {
  id           String   @id @default(uuid()) @db.Uuid
  invoiceId    String   @map("invoice_id") @db.Uuid
  itemType     String   @map("item_type") @db.VarChar(20)
  itemId       String?  @map("item_id") @db.Uuid
  description  String   @db.VarChar(200)
  quantity     Int
  unitPrice    Decimal  @map("unit_price") @db.Decimal(10, 2)
  totalPrice   Decimal  @map("total_price") @db.Decimal(10, 2)
  shaCovered   Boolean  @default(false) @map("sha_covered")
  shaAmount    Decimal  @default(0) @map("sha_amount") @db.Decimal(10, 2)
  patientAmount Decimal? @map("patient_amount") @db.Decimal(10, 2)

  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([itemType])
  @@map("invoice_items")
}

model PaymentAllocation {
  id             String   @id @default(uuid()) @db.Uuid
  invoiceId      String   @map("invoice_id") @db.Uuid
  paymentType    String   @map("payment_type") @db.VarChar(20)
  amount         Decimal  @db.Decimal(10, 2)
  paymentReference String? @map("payment_reference") @db.VarChar(100)
  paymentDate    DateTime @map("payment_date") @db.Date
  notes          String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([paymentType])
  @@map("payment_allocations")
}

model MpesaTransaction {
  id                String   @id @default(uuid()) @db.Uuid
  invoiceId         String   @map("invoice_id") @db.Uuid
  merchantRequestId String   @map("merchant_request_id") @db.VarChar(255)
  checkoutRequestId String   @unique @map("checkout_request_id") @db.VarChar(255)
  phoneNumber       String   @map("phone_number") @db.VarChar(20)
  amount            Int
  accountReference  String   @map("account_reference") @db.VarChar(255)
  transactionDesc   String   @map("transaction_desc") @db.Text
  status            String   @default("Pending") @db.VarChar(20)
  resultCode        Int?     @map("result_code")
  resultDesc        String?  @map("result_desc") @db.Text
  mpesaReceiptNumber String? @map("mpesa_receipt_number") @db.VarChar(255)
  transactionDate   String?  @map("transaction_date") @db.VarChar(50)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  invoice           Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([checkoutRequestId])
  @@index([merchantRequestId])
  @@index([status])
  @@index([createdAt])
  @@map("mpesa_transactions")
}

model MpesaCallbackLog {
  id                 String   @id @default(uuid()) @db.Uuid
  checkoutRequestId  String   @map("checkout_request_id") @db.VarChar(255)
  callbackData       Json     @map("callback_data")
  processedAt        DateTime @default(now()) @map("processed_at") @db.Timestamptz()
  processingStatus   String   @default("Received") @map("processing_status") @db.VarChar(50)
  errorMessage       String?  @map("error_message") @db.Text

  @@index([checkoutRequestId])
  @@index([processedAt])
  @@map("mpesa_callback_logs")
}

model MpesaConfig {
  id                 String   @id @default(uuid()) @db.Uuid
  environment        String   @default("sandbox") @db.VarChar(20)
  consumerKey        String   @map("consumer_key") @db.VarChar(255)
  consumerSecret     String   @map("consumer_secret") @db.VarChar(255)
  passkey            String   @db.VarChar(255)
  businessShortCode  String   @map("business_short_code") @db.VarChar(20)
  callbackUrl        String   @map("callback_url") @db.VarChar(500)
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("mpesa_config")
}

// ==========================================
// LAB TESTS
// ==========================================

model LabTestOrder {
  id                  String   @id @default(uuid()) @db.Uuid
  orderNumber         String   @unique @map("order_number") @db.VarChar(50)
  patientId           String   @map("patient_id") @db.Uuid
  consultationId      String?  @map("consultation_id") @db.Uuid
  orderingClinicianId String   @map("ordering_clinician_id") @db.Uuid
  testType            String   @map("test_type") @db.VarChar(100)
  testCode            String?  @map("test_code") @db.VarChar(50)
  testName            String   @map("test_name") @db.VarChar(255)
  priority            String   @default("routine") @db.VarChar(20)
  clinicalIndication  String?  @map("clinical_indication") @db.Text
  sampleType          String?  @map("sample_type") @db.VarChar(50)
  sampleCollectionDate DateTime? @map("sample_collection_date") @db.Timestamptz()
  status              String   @default("pending") @db.VarChar(20)
  notes               String?  @db.Text
  orderedAt           DateTime @default(now()) @map("ordered_at") @db.Timestamptz()
  collectedAt         DateTime? @map("collected_at") @db.Timestamptz()
  completedAt         DateTime? @map("completed_at") @db.Timestamptz()
  createdById         String?  @map("created_by") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  patient             Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultation        Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  orderingClinician   User     @relation("LabOrderClinician", fields: [orderingClinicianId], references: [id], onDelete: Restrict)
  createdBy           User?    @relation("LabOrderCreator", fields: [createdById], references: [id])
  results             LabTestResult[]
  tasks               Task[]

  @@index([patientId])
  @@index([consultationId])
  @@index([status])
  @@index([orderNumber])
  @@index([orderedAt])
  @@index([testType])
  @@map("lab_test_orders")
}

model LabTestResult {
  id            String   @id @default(uuid()) @db.Uuid
  orderId       String   @map("order_id") @db.Uuid
  resultNumber  String   @unique @map("result_number") @db.VarChar(50)
  testType      String   @map("test_type") @db.VarChar(100)
  testCode      String?  @map("test_code") @db.VarChar(50)
  testName      String   @map("test_name") @db.VarChar(255)
  testValues    Json     @map("test_values")
  referenceRanges Json? @map("reference_ranges")
  abnormalFlags Json?    @map("abnormal_flags")
  resultDate    DateTime @default(now()) @map("result_date") @db.Timestamptz()
  verifiedById  String?  @map("verified_by") @db.Uuid
  verifiedAt    DateTime? @map("verified_at") @db.Timestamptz()
  reviewedById  String?  @map("reviewed_by") @db.Uuid
  reviewedAt    DateTime? @map("reviewed_at") @db.Timestamptz()
  notes         String?  @db.Text
  attachments   Json?
