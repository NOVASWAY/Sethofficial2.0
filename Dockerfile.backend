# Multi-stage build for Rust backend
# Using Rust nightly to support edition2024 dependencies (moxcms requires it)
# Note: edition2024 is still unstable, so we need nightly for now
# The official rustlang/rust repository has nightly builds
FROM rustlang/rust:nightly as builder

# Install system dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    libpq-dev \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy all source files
COPY backend/Cargo.toml ./
COPY backend/Cargo.lock* ./
COPY backend/src ./src
COPY backend/migrations ./migrations

# Build the application
# sqlx::query! macros require DATABASE_URL at compile time
# We'll connect to the postgres service during build to prepare queries
# Note: This requires the postgres service to be running during build
ARG DATABASE_URL
ENV DATABASE_URL=${DATABASE_URL}
# Build the application
# Note: sqlx::query! macros require DATABASE_URL at compile time
# The database should be accessible during build
RUN RUST_BACKTRACE=1 cargo build --release

# Runtime stage
FROM debian:bookworm-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -r -s /bin/false clinic

# Set working directory
WORKDIR /app

# Copy binary from builder stage
COPY --from=builder /app/target/release/clinic-management-backend /app/

# Copy migrations
COPY --from=builder /app/migrations ./migrations

# Create necessary directories and set permissions
RUN mkdir -p /app/uploads /app/logs && \
    chmod +x /app/clinic-management-backend && \
    chown -R clinic:clinic /app

# Switch to non-root user
USER clinic

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Run the application
CMD ["./clinic-management-backend"]
