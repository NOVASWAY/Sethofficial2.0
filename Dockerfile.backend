# Multi-stage build for Rust backend
# Using latest Rust stable - will handle Cargo.lock v4
FROM rust:latest as builder

# Install system dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    libpq-dev \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy all source files
COPY backend/Cargo.toml ./
COPY backend/Cargo.lock* ./
COPY backend/src ./src
COPY backend/migrations ./migrations

# Build the application
# Note: DATABASE_URL should be provided as build arg when postgres is running
# The docker-compose.yml uses network: host so backend can connect to postgres during build
ARG DATABASE_URL
ENV DATABASE_URL=${DATABASE_URL}
RUN RUST_BACKTRACE=1 CARGO_BUILD_JOBS=2 cargo build --release

# Runtime stage
FROM debian:bookworm-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -r -s /bin/false clinic

# Set working directory
WORKDIR /app

# Copy binary from builder stage
COPY --from=builder /app/target/release/clinic-management-backend /app/

# Copy migrations
COPY --from=builder /app/migrations ./migrations

# Create necessary directories and set permissions
RUN mkdir -p /app/uploads /app/logs && \
    chmod +x /app/clinic-management-backend && \
    chown -R clinic:clinic /app

# Switch to non-root user
USER clinic

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Run the application
CMD ["./clinic-management-backend"]
