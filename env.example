# ============================================
# Clinic Management System - Environment Configuration
# ============================================
# Copy this file to .env and update the values for your environment
# 
# SECURITY WARNING: Never commit .env files to version control!
# Always use strong, unique values for production environments
# ============================================

# ============================================
# DATABASE CONFIGURATION
# ============================================
# PostgreSQL database connection string
# Format: postgresql://username:password@host:port/database_name
# Production: Use a strong password and secure connection
POSTGRES_PASSWORD=your_secure_postgres_password_here
DATABASE_URL=postgresql://clinic_user:your_secure_postgres_password_here@localhost:5432/clinic_management

# Database connection pool settings
DB_POOL_SIZE=20
DB_POOL_MAX_CONNECTIONS=50
DB_POOL_TIMEOUT_SECONDS=30

# ============================================
# REDIS CONFIGURATION (Optional - for caching)
# ============================================
# Redis connection string for caching and session storage
# Leave empty if Redis is not available (system will work without cache)
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_URL=redis://:your_secure_redis_password_here@localhost:6379
REDIS_ENABLED=true

# Cache settings
CACHE_TTL=600
CACHE_PREFIX=clinic_management

# ============================================
# JWT AUTHENTICATION CONFIGURATION
# ============================================
# CRITICAL: Generate a strong, random secret key for production!
# Use: openssl rand -base64 32
# Minimum 32 characters recommended
JWT_SECRET=your_very_long_and_secure_jwt_secret_key_here_at_least_32_characters

# JWT token expiration times (in hours)
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=7

# ============================================
# APPLICATION CONFIGURATION
# ============================================
# Server host and port
HOST=0.0.0.0
PORT=8080

# Environment: development, staging, production
ENVIRONMENT=development

# Logging level: trace, debug, info, warn, error
RUST_LOG=info
RUST_BACKTRACE=1

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:3000

# ============================================
# SECURITY SETTINGS
# ============================================
# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Login security
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
SESSION_TIMEOUT=1800

# Password policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL_CHARS=true

# MFA/2FA Configuration
MFA_ISSUER_NAME=Seth Medical Clinic
MFA_ENABLED=true

# ============================================
# FILE UPLOAD SETTINGS
# ============================================
# Maximum file size in bytes (default: 10MB)
MAX_FILE_SIZE=10485760
UPLOAD_PATH=/app/uploads
UPLOAD_DIR=./uploads

# Allowed file types (comma-separated)
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# ============================================
# EMAIL CONFIGURATION (Required for password reset & notifications)
# ============================================
# SMTP server configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
# Note: For Gmail, use an App Password, not your regular password

# Email sender information
FROM_EMAIL=noreply@sethmedicalclinic.com
FROM_NAME=Seth Medical Clinic

# Alternative: SendGrid API (if using SendGrid instead of SMTP)
SENDGRID_API_KEY=your_sendgrid_api_key_here

# ============================================
# SMS CONFIGURATION (Optional - for notifications)
# ============================================
# SMS provider: twilio, africastalking
SMS_PROVIDER=twilio

# Twilio configuration
SMS_ACCOUNT_SID=your_twilio_account_sid
SMS_AUTH_TOKEN=your_twilio_auth_token
SMS_FROM_NUMBER=+1234567890

# Africa's Talking configuration (alternative)
AFRICASTALKING_API_KEY=your_africas_talking_api_key
AFRICASTALKING_USERNAME=your_africas_talking_username
AFRICASTALKING_SENDER_ID=SETHMED

# ============================================
# M-PESA CONFIGURATION (Optional - for payments)
# ============================================
# M-Pesa environment: sandbox or production
MPESA_ENVIRONMENT=sandbox

# M-Pesa API credentials
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_BUSINESS_SHORT_CODE=your_business_short_code
MPESA_PASSKEY=your_mpesa_passkey

# M-Pesa callback URLs
MPESA_CALLBACK_URL=https://yourdomain.com/api/mpesa/callback
MPESA_TIMEOUT_URL=https://yourdomain.com/api/mpesa/timeout

# ============================================
# CLOUD STORAGE CONFIGURATION (Optional)
# ============================================
# Cloud storage provider: aws, gcp, azure, local
CLOUD_STORAGE_PROVIDER=local

# AWS S3 configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-clinic-bucket

# ============================================
# MONITORING & OBSERVABILITY (Optional)
# ============================================
# Enable metrics collection
ENABLE_METRICS=true
METRICS_PORT=9090

# Prometheus retention period
PROMETHEUS_RETENTION=200h

# Grafana admin password (if using Grafana)
GRAFANA_PASSWORD=your_grafana_admin_password

# ============================================
# BACKUP CONFIGURATION
# ============================================
# Backup retention period (in days)
BACKUP_RETENTION_DAYS=30

# Backup schedule (cron expression)
BACKUP_SCHEDULE=0 2 * * *

# Backup storage path
BACKUP_PATH=/app/backups

# ============================================
# SSL/TLS CONFIGURATION (Production)
# ============================================
# SSL certificate paths
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# SSL certificate authority (for Let's Encrypt)
SSL_CA_PATH=/etc/nginx/ssl/ca.pem

# Enable HTTPS
SSL_ENABLED=false

# ============================================
# DOMAIN CONFIGURATION (Production)
# ============================================
DOMAIN=yourclinic.com
SUBDOMAIN=app

# ============================================
# CORS CONFIGURATION
# ============================================
# Allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Enable CORS
CORS_ENABLED=true

# ============================================
# DEVELOPMENT SETTINGS (Development only)
# ============================================
# Enable debug mode
DEBUG=true

# Enable hot reload
HOT_RELOAD=true

# Mock external services (for testing)
MOCK_EXTERNAL_SERVICES=false

# ============================================
# ADDITIONAL SECURITY SETTINGS
# ============================================
# Enable CSRF protection
CSRF_ENABLED=true

# Enable security headers
SECURITY_HEADERS_ENABLED=true

# Content Security Policy
CSP_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'

# ============================================
# PERFORMANCE TUNING
# ============================================
# Worker threads (for Rust backend)
WORKER_THREADS=4

# Request timeout (in seconds)
REQUEST_TIMEOUT=30

# Connection timeout (in seconds)
CONNECTION_TIMEOUT=10

# ============================================
# FEATURE FLAGS
# ============================================
# Enable MFA/2FA
FEATURE_MFA_ENABLED=true

# Enable email verification
FEATURE_EMAIL_VERIFICATION=true

# Enable password reset
FEATURE_PASSWORD_RESET=true

# Enable audit logging
FEATURE_AUDIT_LOGGING=true

# Enable WebSocket real-time updates
FEATURE_WEBSOCKET=true

# ============================================
# NOTES
# ============================================
# 1. All passwords and secrets should be strong and unique
# 2. Use different values for development, staging, and production
# 3. Rotate secrets regularly (especially JWT_SECRET)
# 4. Never commit .env files to version control
# 5. Use environment-specific .env files (.env.development, .env.production)
# 6. Consider using a secrets management service (AWS Secrets Manager, HashiCorp Vault)
# 7. Validate all environment variables on application startup
